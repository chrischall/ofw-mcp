OFW_USERNAME=your-email@example.com
OFW_PASSWORD=your-password

# Optional. Default is "none" (fail-safe): no write tools are
# registered until you opt up. "drafts" = draft-level writes only; "all" =
# everything (send, calendar/expense/journal writes). OFW is a court-of-record
# platform — raise this deliberately.
# OFW_WRITE_MODE=none
# Optional. Default "true" (the long-standing behaviour). Reading a message
# body for the first time marks it READ on OurFamilyWizard and stamps a
# "First Viewed" time your co-parent can see - part of the record, and
# irreversible. Set to "false" to make that impossible on this deployment:
# ofw_get_message refuses such a fetch, and no per-call argument can override it.
# OFW_ALLOW_MARK_READ=true

# Optional. Default "false". Whether ofw_sync_messages fetches unread inbox
# bodies by default (each one stamps a First Viewed time). Capped by
# OFW_ALLOW_MARK_READ.
# OFW_FETCH_UNREAD_BODIES=false
